<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the device. The app's files directory holds live YouTube session
  cookies, so neither cloud backup nor device-to-device transfer may copy it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
